# Copy this file to .env (which is gitignored) and fill in your key.
# The key is read from the environment; it never lives in code.
# Pick ONE provider (default resolution: gemini key present -> gemini, else groq):

# --- Gemini (AI Studio: https://aistudio.google.com/apikey) ---
RA_LLM_PROVIDER=gemini
RA_GEMINI_API_KEY=AQ_REPLACE_ME
# RA_GEMINI_MODEL=gemini-3.6-flash

# --- or Groq (https://console.groq.com -> API Keys) ---
# RA_LLM_PROVIDER=groq
# RA_GROQ_API_KEY=gsk_REPLACE_ME
# RA_GROQ_MODEL=openai/gpt-oss-20b

# Optional overrides
# RA_INDEX_PATH=C:\Users\you\.ra\ra_index.sqlite
# RA_EDGE_TTS_VOICE=en-US-AndrewMultilingualNeural

# --- Speech-to-text ---
# STT_ENGINE: sherpa-onnx (default hybrid: live partials + offline parakeet final)
#   | vosk | whisper
# STT_FINAL: parakeet (default - offline parakeet refines each phrase for max
#   accuracy) | sherpa (streaming result IS final, lowest latency)
#   | whisper (local re-transcribe) | groq (cloud whisper-large-v3-turbo, needs
#   RA_GROQ_API_KEY) | off
# RA_STT_ENGINE=sherpa-onnx          # PTT / batch STT engine (sherpa-onnx | vosk | whisper)
# RA_STT_CONTINUOUS_ENGINE=vosk      # ALWAYS-ON listening engine (vosk proven | sherpa-onnx | whisper)
# RA_STT_FINAL=parakeet
# RA_STT_MIC_DEVICE=2          # force a specific mic device (index or name substring)
# RA_STT_DEBUG=1               # per-block hearing log at ~/.ra/ra_stt_debug.log
# RA_STT_DENOISE=0             # 1 = sherpa GTCRN noise reduction (default off)